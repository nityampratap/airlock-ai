# =================================================================
# AIRLOCK AI — Environment Configuration Template
# Copy this file to .env (or .env.local) and customize for deployment
# =================================================================

# Server & Runtime Environment
DEBUG=false
PROJECT_NAME="AIRLOCK AI"
VERSION="1.0.0"

# Security & Authentication
# Generate a secure 64+ char random string: openssl rand -base64 48
SECRET_KEY=change-this-to-a-secure-random-64-character-secret-in-production
ALGORITHM=HS256
TOKEN_EXPIRE_MINUTES=1440

# Database
# For SQLite (default development):
DATABASE_URL=sqlite:///./backend/airlock_ai.db
# For PostgreSQL (production recommended):
# DATABASE_URL=postgresql://airlock_user:your_password@localhost:5432/airlock_db

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8005,http://127.0.0.1:8005

# TinyFish Web Agent API (optional for live public research sync)
TINYFISH_API_KEY=
TINYFISH_API_BASE=https://agent.tinyfish.ai/v1
TINYFISH_AGENT_ENDPOINT=https://agent.tinyfish.ai/v1/automation/run-sse
TINYFISH_AGENT_RUN_ENDPOINT=https://agent.tinyfish.ai/v1/automation/run

# Staging Application URL (for browser agent validation)
STAGING_APP_URL=http://localhost:3000/staging/agent-chat

# Cryptographic Keys (optional environment injection for Ed25519)
# ED25519_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\n..."
# ED25519_PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----\n..."

# Commercial Billing (Stripe)
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://127.0.0.1:8005/api/v1
